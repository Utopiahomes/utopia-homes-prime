{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.stoin.local/shared-execution/v1/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "correlation_id",
    "error"
  ],
  "properties": {
    "contract": {
      "const": "stoin.inference.execute.error.v1"
    },
    "correlation_id": {
      "$ref": "common.defs.json#/$defs/uuid4"
    },
    "request_id": {
      "$ref": "common.defs.json#/$defs/uuid4"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "state"
      ],
      "properties": {
        "execution_id": {
          "$ref": "common.defs.json#/$defs/uuid4"
        },
        "state": {
          "enum": [
            "admitted",
            "dispatched",
            "completed",
            "failed",
            "outcome_unknown"
          ]
        }
      }
    },
    "cost": {
      "$ref": "common.defs.json#/$defs/cost"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "authentication_failed",
            "capability_forbidden",
            "route_not_found",
            "method_not_allowed",
            "response_media_not_acceptable",
            "execution_aborted",
            "idempotency_conflict",
            "request_in_progress",
            "idempotency_recovery_unavailable",
            "execution_outcome_unknown",
            "execution_invalidated",
            "request_too_large",
            "unsupported_media_type",
            "output_contract_unsupported",
            "cost_ceiling_insufficient",
            "rate_limited",
            "provider_response_invalid",
            "provider_response_too_large",
            "output_limit_reached",
            "content_filtered",
            "provider_execution_failed",
            "cost_settlement_violation",
            "privacy_route_unavailable",
            "authentication_state_unavailable",
            "state_store_unavailable",
            "spending_authority_exhausted",
            "temporarily_unavailable",
            "deadline_exceeded"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "invalid_request"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution request is invalid."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "authentication_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Service authentication failed."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "capability_forbidden"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "This execution capability is not permitted."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "route_not_found"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The requested execution route was not found."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "method_not_allowed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution method is not allowed."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "response_media_not_acceptable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The requested response media type is not supported."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "execution_aborted"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution ended before model dispatch."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "idempotency_conflict"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The idempotency key conflicts with an earlier request."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "request_in_progress"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution request is already in progress."
              },
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "idempotency_recovery_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The earlier execution result is no longer available."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "execution_outcome_unknown"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution outcome could not be determined."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "execution_invalidated"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The earlier execution result is no longer eligible."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "request_too_large"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution request is too large."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unsupported_media_type"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution request media type is not supported."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "output_contract_unsupported"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The requested output contract is not supported."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "cost_ceiling_insufficient"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The execution cost ceiling is insufficient."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "rate_limited"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Execution capacity is temporarily limited."
              },
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "provider_response_invalid"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The model returned an unusable result."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "provider_response_too_large"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The model response is too large."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "output_limit_reached"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The model reached its output limit."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "content_filtered"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The model response was filtered."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "provider_execution_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The model execution failed."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "cost_settlement_violation"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "The provider charge exceeded its reservation."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "privacy_route_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "No approved private execution route is available."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "authentication_state_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Service authentication state is temporarily unavailable."
              },
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "state_store_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Execution state is temporarily unavailable."
              },
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "spending_authority_exhausted"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Execution spending authority is unavailable."
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "temporarily_unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Model execution is temporarily unavailable."
              },
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "deadline_exceeded"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "message": {
                "const": "Model execution exceeded its deadline."
              },
              "retryable": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
