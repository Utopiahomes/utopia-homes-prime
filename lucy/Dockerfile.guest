# Guest Lucy: drafts replies to booked guests, woken by Homes Prime's signed webhook. Unmodified
# Hermes (the same pinned image as operator Lucy), with the guest profile. Build from the root:
#   docker build -f lucy/Dockerfile.guest -t utopia-lucy-guest .
FROM docker.io/nousresearch/hermes-agent:v2026.8.19@sha256:3811ed13da874fba2ac99b6d492db9a203d34cb6dccf90d886948c00d0ccec09

COPY lucy/guest /opt/utopia-lucy/profile
COPY --chmod=0755 lucy/start.sh /opt/utopia-lucy/start.sh

EXPOSE 8644
ENTRYPOINT ["/opt/utopia-lucy/start.sh"]
CMD ["gateway", "run"]
